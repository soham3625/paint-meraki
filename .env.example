# ============================================
# PAINT MERAKI — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development
# NEVER commit real credentials to version control
# ============================================

# Database (PostgreSQL / Supabase / Neon / Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/paint_meraki?schema=public"

# Session & JWT Secrets (Minimum 32 random characters in production)
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-secret"
NEXTAUTH_URL="https://paintnmeraki.vercel.app"
JWT_ACCESS_SECRET="change-this-to-a-secure-random-32-char-secret"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-32-char-secret"

# Cloudinary (Optional Image Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# WhatsApp Business / Owner Notification
WHATSAPP_API_TOKEN="your_whatsapp_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
OWNER_WHATSAPP_NUMBER="919000000000"

# Storefront Site Config
NEXT_PUBLIC_SITE_URL="https://paintnmeraki.vercel.app"
APP_URL="https://paintnmeraki.vercel.app"
UPI_ID="paintmeraki@upi"
UPI_NAME="Paint Meraki"

# Firebase Client SDK Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase Admin SDK Configuration (Server-side verification)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email"
FIREBASE_PRIVATE_KEY="your-private-key"

# Email Service (Resend - Free Tier: 100 emails/day, 3,000/month)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Paint Meraki <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Paint Meraki <onboarding@resend.dev>"
RESEND_REPLY_TO="noreply@example.com"

# OTP Hashing Secret (Optional salt for HMAC-SHA256, defaults to NEXTAUTH_SECRET/SESSION_SECRET)
OTP_SECRET="your-cryptographic-salt-for-email-otp-hashing"
